npm run render:pdfs

git add documents/CN_Resume.pdf documents/CN_References.pdf

# --name-only rather than --quiet: Git for Windows maps *.pdf to the
# astextplain textconv driver, and --quiet/--exit-code compare the converted
# text, so they report no change even when the bytes differ. --name-only
# reports the path either way, and behaves the same on every machine.
CHANGED=$(git diff --cached --name-only -- documents/CN_Resume.pdf documents/CN_References.pdf)

if [ -n "$CHANGED" ]; then
  echo "PDFs are out of date. Regenerated and staged:"
  echo "$CHANGED" | sed "s/^/  /"
  echo "Commit them, then push again."
  exit 1
fi
