# Spotify "now playing" widget. Omit these and the widget quietly shows nothing.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional. Raises the GitHub API rate limit during builds from 60/hr to 5000/hr.
# Only needs public_repo (or no scopes at all) since it reads public data.
GITHUB_TOKEN=

# Optional. Analytics scripts are only loaded when this is set.
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Optional. Defaults to Ne-k.
NEXT_PUBLIC_GITHUB_USER=

# Cloudflare Turnstile, which gates the resume and reference PDFs. Without both
# of these the documents are served freely in development and refused in
# production, because a check that fails open is not a check.
CF_KEY=
CF_SECRET=
